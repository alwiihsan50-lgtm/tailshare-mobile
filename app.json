{
  "expo": {
    "name": "TailShare",
    "slug": "tailshare-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tailshare",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cuker.tailshare",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "TailShare membutuhkan akses ke galeri foto untuk mengirim gambar dan video langsung ke PC.",
        "NSPhotoLibraryAddUsageDescription": "TailShare membutuhkan izin untuk menyimpan media dari PC ke galeri iPhone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing"
    ]
  }
}
